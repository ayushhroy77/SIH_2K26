# ==============================================================================
# CVGuard Infrastructure Environment Variables Template
# Copy this file to `infra/.env` or repo root `.env` before starting services.
#
# NOTE: This system is designed to run fully offline/air-gapped in production;
# local dev uses standard package registries for convenience only.
# ==============================================================================

# --- Environment & Logging ---
CVGUARD_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL 16 Credentials ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cvguard
POSTGRES_USER=cvguard_admin
POSTGRES_PASSWORD=cvguard_dev_secret_change_me_in_prod

# Dedicated restricted database role for append-only audit ledger (INSERT & SELECT only)
POSTGRES_LEDGER_USER=cvguard_ledger
POSTGRES_LEDGER_PASSWORD=cvguard_ledger_secret_change_me_in_prod

# --- Redis 7 Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=cvguard_redis_secret_change_me_in_prod

# --- MinIO (S3-Compatible Offline Blob Store) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_dev_secret_change_me_in_prod
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKETS=cvguard-artifacts,cvguard-datasets,cvguard-reports

# --- Service Host Ports (External Mapping) ---
GATEWAY_PORT=8000
DATA_PLANE_PORT=8001
MODEL_PLANE_PORT=8002
INFERENCE_PLANE_PORT=8003
DRIFT_PLANE_PORT=8004
GOVERNANCE_PORT=8005

# --- Internal Service Discovery Endpoints ---
INTERNAL_GATEWAY_URL=http://gateway:8000
INTERNAL_DATA_PLANE_URL=http://data-plane:8001
INTERNAL_MODEL_PLANE_URL=http://model-plane:8002
INTERNAL_INFERENCE_PLANE_URL=http://inference-plane:8003
INTERNAL_DRIFT_PLANE_URL=http://drift-plane:8004
INTERNAL_GOVERNANCE_URL=http://governance:8005
