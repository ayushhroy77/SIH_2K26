# ==============================================================================
# CVGuard Infrastructure Environment Configuration Template
# ==============================================================================

# System Environment Mode (development | staging | production)
CVGUARD_ENV=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_DB=cvguard
POSTGRES_USER=cvguard_admin
POSTGRES_PASSWORD=cvguard_dev_secret_change_me_in_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Dedicated restricted database user for append-only audit ledger operations
POSTGRES_LEDGER_USER=cvguard_ledger
POSTGRES_LEDGER_PASSWORD=cvguard_ledger_secret_change_me_in_prod

# Redis Configuration
REDIS_PASSWORD=cvguard_redis_dev_secret_change_me
REDIS_PORT=6379

# MinIO (S3-compatible offline storage)
MINIO_ROOT_USER=cvguard_minio_admin
MINIO_ROOT_PASSWORD=cvguard_minio_dev_secret_change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Service Ports
GATEWAY_PORT=8000
DATA_PLANE_PORT=8001
MODEL_PLANE_PORT=8002
INFERENCE_PLANE_PORT=8003
DRIFT_PLANE_PORT=8004
GOVERNANCE_PORT=8005

# Internal Service Interconnect URLs (mTLS Enabled)
INTERNAL_GOVERNANCE_URL=https://governance:8005
INTERNAL_DATA_PLANE_URL=https://data-plane:8001
INTERNAL_MODEL_PLANE_URL=https://model-plane:8002

# Phase 8: Mutual TLS (mTLS) Configuration
CVGUARD_MTLS_ENABLED=true
CVGUARD_CA_CERT_PATH=/etc/cvguard/certs/ca.crt
CVGUARD_CERT_PATH=/etc/cvguard/certs/service.crt
CVGUARD_KEY_PATH=/etc/cvguard/certs/service.key

# Phase 8: Keycloak OIDC Authentication & RBAC Configuration
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=cvguard
KEYCLOAK_CLIENT_ID=cvguard-gateway
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_dev_secret_change_me

# Data Plane Configuration
HAMMING_DISTANCE_THRESHOLD=10
